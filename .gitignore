# GCP service account keys
lc-ice-*.json
*-sa-key*.json
*service-account*.json

# Prisma migration dumps (local debug artefacts — never commit)
packages/db/.migration-dump/

# Schema extraction artefacts (regenerated by `tools/build-schemas.ts`).
# Only the final SQLite catalog (packages/core/data/ice-schemas.db) is
# tracked. Everything else under generated/ is reproducible from the
# Terraform Registry and far too large for GitHub (resource-types.ts is
# ~185 MB, unified-types.json ~184 MB, raw/terraform-aws.json ~107 MB —
# all over the 100 MB push limit). The cache + log dirs are build-time
# only.
packages/core/src/schemas/generated/raw/
packages/core/src/schemas/generated/manifest.json
packages/core/src/schemas/generated/unified-types.json
packages/core/src/schemas/generated/resource-types.ts
packages/core/src/schemas/generated/index.ts
packages/core/src/schemas/data/
packages/core/data/ice-schemas.db.bak
.schema-cache/
.schema-build-logs/

# Misc
*.tgz
.cache/
.turbo/
