{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true
  },
  "references": [
    { "path": "packages/types" },
    { "path": "packages/db" },
    { "path": "packages/shared" },
    { "path": "packages/core" },
    { "path": "packages/blocks" },
    { "path": "packages/templates" },
    { "path": "packages/providers/gcp" },
    { "path": "packages/providers/aws" },
    { "path": "packages/providers/azure" },
    { "path": "packages/ui" },
    { "path": "services/iam" },
    { "path": "services/canvas" },
    { "path": "services/deploy" },
    { "path": "services/ai" },
    { "path": "services/engine" },
    { "path": "services/credentials" },
    { "path": "services/billing" },
    { "path": "apps/gateway" }
  ],
  "exclude": ["node_modules", "dist", "packages/web"]
}
