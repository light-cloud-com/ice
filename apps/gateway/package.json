    "@ice/service-engine": "workspace:*",
    "@ice/service-iam": "workspace:*",
    "@ice/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "socket.io": "^4.8.3"
