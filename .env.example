# ICE Community Edition — Environment Variables
#
# Copy this file to .env and adjust values as needed.
# Only DATABASE_URL, JWT_SECRET, and CREDENTIAL_ENCRYPTION_KEY are required.
#
# The dev scripts (pnpm dev:desktop, dev:saas) override DATABASE_URL to point
# at a workspace-local SQLite file, so you don't need to change it for dev.

# ─── Database (required) ─────────────────────────────────────────────────────
# SQLite — a path relative to packages/db/prisma/, or an absolute file: URL.
DATABASE_URL=file:../../.desktop-dev.db

# ─── Security (required) ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string
CREDENTIAL_ENCRYPTION_KEY=change-me-32-characters-exactly!!

# ─── Server ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
PORT=15173
NODE_ENV=development

# ─── AI Assistant (optional — enables AI chat panel) ─────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# ─── E2E test credentials (optional — only for test:gcp / test:scenarios) ────
# These are picked up by Playwright via e2e/playwright.config.ts.
# Values here are NEVER read by the running app — strictly test-only.
#
# GCP project that test deploys land in. Use a disposable project with a
# strict budget — these tests provision and tear down real resources.
# ICE_TEST_GCP_PROJECT=my-disposable-test-project
#
# Path to the service-account JSON key with deploy permissions on the project.
# ICE_TEST_SA_KEY_PATH=/absolute/path/to/sa-key.json
#
# GCP region for resources that need one (default: us-central1).
# ICE_TEST_GCP_REGION=us-central1
#
# GitHub PAT for scenarios that pull a source repo. Needs `repo` scope.
# ICE_TEST_GITHUB_TOKEN=github_pat_...
#
# Apex domain used by the static-site-with-domain scenario.
# ICE_TEST_DOMAIN=example.test
