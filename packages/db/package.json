{
  "name": "@ice/db",
  "version": "0.1.0",
  "description": "Prisma schema, migrations, and client singleton",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
