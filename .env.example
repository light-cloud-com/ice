# ICE Community Edition — Environment Variables
#
# Copy this file to .env and adjust values as needed.
# Only DATABASE_URL, JWT_SECRET, and CREDENTIAL_ENCRYPTION_KEY are required.
#
# The dev scripts (pnpm dev:desktop, dev:saas) override DATABASE_URL to point
# at a workspace-local SQLite file, so you don't need to change it for dev.

# ─── Database (required) ─────────────────────────────────────────────────────
# SQLite — a path relative to packages/db/prisma/, or an absolute file: URL.
DATABASE_URL=file:../../.desktop-dev.db

# ─── Security (required) ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string
CREDENTIAL_ENCRYPTION_KEY=change-me-32-characters-exactly!!

# ─── Server ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
PORT=15173
NODE_ENV=development

# ─── AI Assistant (optional — enables AI chat panel) ─────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
