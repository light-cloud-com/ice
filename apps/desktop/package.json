{
  "name": "@ice/desktop",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "ICE Desktop - Standalone Electron app for cloud infrastructure design & deployment",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm --filter @ice/gateway build && pnpm --filter @ice/web build && node scripts/copy-prisma.mjs",
    "pack": "pnpm prebuild && electron-vite build && electron-builder --dir",
    "dist": "pnpm prebuild && electron-vite build && electron-builder",
    "dist:mac": "pnpm prebuild && electron-vite build && electron-builder --mac",
    "dist:mac:arm64": "pnpm prebuild && electron-vite build && electron-builder --mac --arm64",
    "dist:mac:x64": "pnpm prebuild && electron-vite build && electron-builder --mac --x64",
    "dist:win": "pnpm prebuild && electron-vite build && electron-builder --win",
    "dist:win:x64": "pnpm prebuild && electron-vite build && electron-builder --win --x64",
    "dist:linux": "pnpm prebuild && electron-vite build && electron-builder --linux",
    "dist:linux:x64": "pnpm prebuild && electron-vite build && electron-builder --linux --x64",
    "dist:linux:arm64": "pnpm prebuild && electron-vite build && electron-builder --linux --arm64",
    "dist:all": "pnpm prebuild && electron-vite build && electron-builder --mac --arm64 && electron-builder --mac --x64 && electron-builder --win --x64 && electron-builder --linux --x64 && electron-builder --linux --arm64"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@ice/blocks": "workspace:*",
    "@ice/core": "workspace:*",
    "@ice/db": "workspace:*",
    "@ice/gateway": "workspace:*",
    "@ice/provider-gcp": "workspace:*",
    "@ice/shared": "workspace:*",
    "@ice/types": "workspace:*",
    "@ice/ui": "workspace:*",
    "bindings": "^1.5.0",
    "electron-updater": "^6.8.3",
    "file-uri-to-path": "^2.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.15",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.15",
    "prebuild-install": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
