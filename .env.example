# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ice:icedev@localhost:5556/ice_saas

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Security (REQUIRED — no defaults in production) ─────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-random-32-char-key!

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── OAuth (optional — needed for Google/GitHub login) ───────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# BACKEND_URL=http://localhost:5001

# ─── AI (optional — needed for AI assistant) ─────────────────────────────────
# ANTHROPIC_API_KEY=

# ─── Stripe (optional — needed for billing) ──────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Scheduled Jobs (optional) ───────────────────────────────────────────────
# SCHEDULER_API_KEY=
