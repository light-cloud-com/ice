{
  "name": "@ice/gateway",
  "version": "0.1.0",
  "description": "API Gateway - composes all services into a single Express app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ice/db": "workspace:*",
