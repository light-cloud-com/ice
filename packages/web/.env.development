VITE_API_URL=/api
# Unset VITE_WS_URL so the client uses window.location.origin (the vite dev
# server at 5174 which proxies /socket.io to the gateway). Hardcoding a
# gateway port here means the browser bypasses the vite proxy and hits
# the gateway directly — which only works if the port matches AND CORS
# allows it. Leaving this blank is the safe default for dev.
VITE_WS_URL=
VITE_GOOGLE_CLIENT_ID=
